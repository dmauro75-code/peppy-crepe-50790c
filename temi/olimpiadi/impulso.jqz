<clue></clue>
<category></category>
<weighting>100</weighting>
<fixed>0</fixed>
<question-type>1</question-type>
<answers>
<answer><text>La Q.d.M. del sistema si conserva, l&apos;energia cin. del sistema si conserva, l&apos;urto &amp;#x00e8; elastico.</text>
<feedback></feedback>
<correct>0</correct>
<percent-correct>0</percent-correct>
